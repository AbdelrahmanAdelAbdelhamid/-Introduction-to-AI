# 6. Evaluation
# ============================================================

def evaluate(agent_factory, steps=50, runs=200, **env_kwargs):
    """Calculate the average score over multiple runs."""
    total_score = 0.0

    for seed in range(runs):
        environment = VacuumEnv(seed=seed, **env_kwargs)
        total_score += run(agent_factory(), environment, steps)

    return total_score / runs


