# ============================================================
# 3. Vacuum-Cleaner World
# ============================================================

class VacuumEnv:
    """Environment for the two-room vacuum-cleaner world."""

    def __init__(
        self,
        rooms=("A", "B"),
        dirty=("A", "B"),
        start="A",
        p_dirty_again=0.0,
        p_suck_fail=0.0,
        seed=None
    ):
        self.rooms = list(rooms)
        self.status = {
            room: ("Dirty" if room in dirty else "Clean")
            for room in self.rooms
        }
        self.loc = start
        self.p_dirty_again = p_dirty_again
        self.p_suck_fail = p_suck_fail
        self.rng = random.Random(seed)

    def percept(self):
        """Return the current location and its cleanliness status."""
        return self.loc, self.status[self.loc]

    def step(self, action):
        """Apply an action and return the reward."""
        index = self.rooms.index(self.loc)
        move_cost = 0.0

        if action == "Suck":
            if self.rng.random() >= self.p_suck_fail:
                self.status[self.loc] = "Clean"

        elif action == "Right" and index < len(self.rooms) - 1:
            self.loc = self.rooms[index + 1]
            move_cost = 0.5

        elif action == "Left" and index > 0:
            self.loc = self.rooms[index - 1]
            move_cost = 0.5

        elif action == "NoOp":
            pass

        for room in self.rooms:
            if (
                self.status[room] == "Clean"
                and self.rng.random() < self.p_dirty_again
            ):
                self.status[room] = "Dirty"

        clean_rooms = sum(
            status == "Clean"
            for status in self.status.values()
        )

        return clean_rooms - move_cost


