# 5. Simulation
# ============================================================

def run(agent, env, steps=20, verbose=False):
    """Run an agent in an environment for a fixed number of steps."""
    total = 0.0

    for t in range(steps):
        percept = env.percept()
        action = agent(percept)
        reward = env.step(action)
        total += reward

        if verbose:
            print(
                f"t={t:2d} "
                f"percept={percept!s:18} "
                f"action={action:6} "
                f"reward={reward:4.1f} "
                f"status={env.status}"
            )

    return total


